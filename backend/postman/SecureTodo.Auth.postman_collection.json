{
  "info": {
    "_postman_id": "b7f3a1c2-5d4e-4f6a-9b8c-1e2d3f4a5b6c",
    "name": "SecureTodo — Auth API",
    "description": "Complete auth API collection. Flow guide:\n1. Register → grab devOtp from the response (works when SMTP is off) → Verify OTP.\n2. Login sets the httpOnly refresh cookie automatically (Postman cookie jar).\n3. CSRF: copy the `csrfToken` cookie value into the `X-CSRF-Token` header for refresh-token/logout calls (Postman sends cookies, but the header echo must be manual — see the two saved headers).\n\nVariables at the collection level: baseUrl, email, phone, password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5050" },
    { "key": "email", "value": "you@example.com" },
    { "key": "phone", "value": "+919876543210" },
    { "key": "password", "value": "Passw0rd!23" },
    { "key": "devOtp", "value": "" },
    { "key": "pendingToken", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "accessToken", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0 · Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Auth / Registration",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.devOtp) pm.collectionVariables.set('devOtp', d.devOtp);",
                  "pm.test('201 created', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Rate limit: 5/hour/IP. Returns devOtp when SMTP is unconfigured."
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.data?.accessToken) pm.collectionVariables.set('accessToken', d.data.accessToken);",
                  "pm.test('verified', () => pm.expect(pm.response.code).to.eql(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{devOtp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-otp",
            "description": "Activates the account AND logs in (sets refresh cookie + returns accessToken)."
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/resend-otp"
          }
        }
      ]
    },
    {
      "name": "Auth / Session lifecycle",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.data?.accessToken) pm.collectionVariables.set('accessToken', d.data.accessToken);",
                  "if (d.data?.pendingToken) pm.collectionVariables.set('pendingToken', d.data.pendingToken);",
                  "pm.test('login ok or 2FA pending', () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"rememberMe\": true\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "`email` accepts an email OR a phone number. rememberMe=true stretches the cookie to 30 days. When 2FA is enabled the response contains pendingToken instead of a session."
          }
        },
        {
          "name": "Verify login OTP (2FA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.data?.accessToken) pm.collectionVariables.set('accessToken', d.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pendingToken\": \"{{pendingToken}}\",\n  \"otp\": \"123456\",\n  \"rememberMe\": true\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-login-otp"
          }
        },
        {
          "name": "Refresh token (rotate)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-CSRF-Token", "value": "<paste csrfToken cookie value>" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/refresh-token",
            "description": "Cookie-authenticated. Requires the X-CSRF-Token header to match the readable csrfToken cookie (double-submit). Rotates the refresh token; replaying an old one revokes ALL sessions."
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Sessions list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "const first = d.data?.sessions?.find(s => !s.current);",
                  "if (first) pm.collectionVariables.set('sessionId', first.id);"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/sessions" }
        },
        {
          "name": "Revoke session by id",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/auth/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Toggle 2FA",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"enabled\": true\n}" },
            "url": "{{baseUrl}}/api/auth/2fa"
          }
        },
        {
          "name": "Logout (this device)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-CSRF-Token", "value": "<paste csrfToken cookie value>" }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Blacklists the presented refresh token permanently."
          }
        },
        {
          "name": "Logout all devices",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout-all" }
        },
        {
          "name": "Admin ping (role gate)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/admin/ping" }
        }
      ]
    },
    {
      "name": "Password reset",
      "item": [
        {
          "name": "Forgot password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.devOtp) pm.collectionVariables.set('devOtp', d.devOtp);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{devOtp}}\",\n  \"newPassword\": \"FreshPass!456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Sets the new password and invalidates ALL existing sessions."
          }
        }
      ]
    },
    {
      "name": "Todos",
      "item": [
        {
          "name": "List todos",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/todos" }
        },
        {
          "name": "Create todo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"task\": \"Ship the auth system\"\n}" },
            "url": "{{baseUrl}}/api/todos"
          }
        },
        {
          "name": "Toggle todo",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/todos/:id" }
        },
        {
          "name": "Delete todo",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/todos/:id" }
        }
      ]
    }
  ]
}
