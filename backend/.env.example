# ──────────────────────────────────────────────────────────────
# Backend environment template
# Copy to `.env` and fill in real values:  cp .env.example .env
# NEVER commit the real .env (it is git-ignored).
# ──────────────────────────────────────────────────────────────

# Runtime: "development" | "production"
NODE_ENV=development

# Port the API listens on (8080 was occupied on this machine, so we use 5050)
PORT=5050

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/todoapp

# Frontend origin allowed by CORS (must match the Vite dev server / domain)
CLIENT_URL=http://localhost:5173

# ── JWT secrets ───────────────────────────────────────────────
# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-too
JWT_REFRESH_EXPIRES_IN=7d
# "Remember me" sessions stretch the refresh cookie to this lifetime:
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
# How long a passed password check waits for the 2FA code:
TWO_FACTOR_PENDING_TTL=10m

# ── Cookies ───────────────────────────────────────────────────
REFRESH_TOKEN_COOKIE_NAME=refreshToken
CSRF_COOKIE_NAME=csrfToken
# lax fits same-site deploys; use "none" (+ HTTPS) only cross-site.
COOKIE_SAMESITE=lax

# ── OTP (email codes: verify, 2FA, password reset) ────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Account lockout (brute-force defense) ─────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=60

# ── Rate limits (requests per window per IP) ──────────────────
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MINUTES=60
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=60

# ── SMTP (leave SMTP_HOST empty in dev to get devOtp in responses) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Secure Todo <no-reply@todoapp.local>"

# ── Google reCAPTCHA v3 (optional; enforced only when secret set) ──
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
